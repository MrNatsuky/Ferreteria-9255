<%- include('parciales/encabezado') %>

<% if (error) { %>
  <div class="alerta"><%= error %></div>
<% } %>

<% const accion = editar ? '/categorias/' + editar.ID_CATEGORIA + '/editar' : '/categorias'; %>

<% if (editar || permiso.PUEDE_CREAR === 'S') { %>
  <form method="POST" action="<%= accion %>" class="formulario">
    <h2><%= editar ? 'Editar categoria' : 'Nueva categoria' %></h2>

    <label>Nombre</label>
    <input type="text" name="nombre" maxlength="60" required value="<%= editar ? editar.NOMBRE : '' %>">

    <label>Descripcion</label>
    <input type="text" name="descripcion" maxlength="200" value="<%= editar ? editar.DESCRIPCION : '' %>">

    <button type="submit">Guardar</button>
    <% if (editar) { %>
      <a href="/categorias">Cancelar</a>
    <% } %>
  </form>
<% } %>

<table class="tabla">
  <thead>
    <tr>
      <th>ID</th>
      <th>Nombre</th>
      <th>Descripcion</th>
      <th>Acciones</th>
    </tr>
  </thead>
  <tbody>
    <% categorias.forEach((c) => { %>
      <tr>
        <td><%= c.ID_CATEGORIA %></td>
        <td><%= c.NOMBRE %></td>
        <td><%= c.DESCRIPCION %></td>
        <td>
          <% if (permiso.PUEDE_MODIFICAR === 'S') { %>
            <a href="/categorias?editar=<%= c.ID_CATEGORIA %>">Editar</a>
          <% } %>
          <% if (permiso.PUEDE_ELIMINAR === 'S') { %>
            <form method="POST" action="/categorias/<%= c.ID_CATEGORIA %>/eliminar" class="en-linea" onsubmit="return confirm('Eliminar esta categoria?')">
              <button type="submit">Eliminar</button>
            </form>
          <% } %>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<%- include('parciales/pie') %>