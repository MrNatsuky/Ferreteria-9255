<%- include('parciales/encabezado') %>

<% if (error) { %>
  <div class="alerta"><%= error %></div>
<% } %>

<% const accion = editar ? '/formas-pago/' + editar.ID_FORMA_PAGO + '/editar' : '/formas-pago'; %>

<% if (editar || permiso.PUEDE_CREAR === 'S') { %>
  <form method="POST" action="<%= accion %>" class="formulario">
    <h2><%= editar ? 'Editar forma de pago' : 'Nueva forma de pago' %></h2>

    <label>Nombre</label>
    <input type="text" name="nombre" maxlength="30" required value="<%= editar ? editar.NOMBRE : '' %>">

    <label>Requiere numero de referencia</label>
    <select name="requiere">
      <option value="N" <%= editar && editar.REQUIERE_REFERENCIA === 'N' ? 'selected' : '' %>>No</option>
      <option value="S" <%= editar && editar.REQUIERE_REFERENCIA === 'S' ? 'selected' : '' %>>Si</option>
    </select>

    <button type="submit">Guardar</button>
    <% if (editar) { %>
      <a href="/formas-pago">Cancelar</a>
    <% } %>
  </form>
<% } %>

<table class="tabla">
  <thead>
    <tr>
      <th>ID</th>
      <th>Nombre</th>
      <th>Requiere referencia</th>
      <th>Acciones</th>
    </tr>
  </thead>
  <tbody>
    <% formas.forEach((f) => { %>
      <tr>
        <td><%= f.ID_FORMA_PAGO %></td>
        <td><%= f.NOMBRE %></td>
        <td><%= f.REQUIERE_REFERENCIA === 'S' ? 'Si' : 'No' %></td>
        <td>
          <% if (permiso.PUEDE_MODIFICAR === 'S') { %>
            <a href="/formas-pago?editar=<%= f.ID_FORMA_PAGO %>">Editar</a>
          <% } %>
          <% if (permiso.PUEDE_ELIMINAR === 'S') { %>
            <form method="POST" action="/formas-pago/<%= f.ID_FORMA_PAGO %>/eliminar" class="en-linea" onsubmit="return confirm('Eliminar esta forma de pago?')">
              <button type="submit">Eliminar</button>
            </form>
          <% } %>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<%- include('parciales/pie') %>